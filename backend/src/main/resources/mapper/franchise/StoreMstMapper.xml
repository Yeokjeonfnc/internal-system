<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yeokjeon.erp.franchise.mapper.StoreMstMapper">

    <resultMap id="storeMstDto" type="com.yeokjeon.erp.franchise.dto.StoreMstDto">
        <constructor>
            <arg column="store_idx" javaType="java.lang.Integer"/>
            <arg column="store_cd" javaType="java.lang.String"/>
            <arg column="store_nm" javaType="java.lang.String"/>
            <arg column="owner_nm" javaType="java.lang.String"/>
            <arg column="region_cd" javaType="java.lang.String"/>
            <arg column="region_nm" javaType="java.lang.String"/>
            <arg column="store_tel" javaType="java.lang.String"/>
            <arg column="address" javaType="java.lang.String"/>
            <arg column="latitude" javaType="java.math.BigDecimal"/>
            <arg column="longitude" javaType="java.math.BigDecimal"/>
            <arg column="store_status" javaType="java.lang.String"/>
            <arg column="store_status_nm" javaType="java.lang.String"/>
            <arg column="closed_yn" javaType="java.lang.Boolean"/>
            <arg column="cont_end_dt" javaType="java.time.LocalDate"/>
            <arg column="auto_renewal_yn" javaType="java.lang.Boolean"/>
            <arg column="store_type" javaType="java.lang.String"/>
            <arg column="store_type_nm" javaType="java.lang.String"/>
            <arg column="sv_id" javaType="java.lang.String"/>
            <arg column="sv_nm" javaType="java.lang.String"/>
            <arg column="created_at" javaType="java.time.LocalDateTime"/>
            <arg column="updated_at" javaType="java.time.LocalDateTime"/>
            <arg column="adress_detail" javaType="java.lang.String"/>
            <arg column="zip_cd" javaType="java.lang.String"/>
            <arg column="brand_cd" javaType="java.lang.String"/>
            <arg column="brand_nm" javaType="java.lang.String"/>
            <arg column="cont_start_dt" javaType="java.time.LocalDate"/>
            <arg column="business_number" javaType="java.lang.String"/>
            <arg column="first_cont_dt" javaType="java.time.LocalDate"/>
            <arg column="transfer_date" javaType="java.time.LocalDate"/>
            <arg column="fr_fee" javaType="java.math.BigDecimal"/>
            <arg column="edu_fee" javaType="java.math.BigDecimal"/>
            <arg column="insu_deposit" javaType="java.math.BigDecimal"/>
            <arg column="cont_deposit" javaType="java.math.BigDecimal"/>
            <arg column="cont_manager" javaType="java.lang.String"/>
            <arg column="cont_manager_nm" javaType="java.lang.String"/>
            <arg column="edu_manager" javaType="java.lang.String"/>
            <arg column="edu_manager_nm" javaType="java.lang.String"/>
            <arg column="cont_area" javaType="java.math.BigDecimal"/>
            <arg column="real_area" javaType="java.math.BigDecimal"/>
            <arg column="floor" javaType="java.lang.Integer"/>
            <arg column="parking_count" javaType="java.lang.Integer"/>
            <arg column="premium_fee" javaType="java.lang.Integer"/>
            <arg column="monthly_rent" javaType="java.lang.Integer"/>
            <arg column="rent_deposit" javaType="java.lang.Integer"/>
            <arg column="notes" javaType="java.lang.String"/>
            <arg column="prop_idx" javaType="java.lang.Integer"/>
            <arg column="partner_idx" javaType="java.lang.Integer"/>
        </constructor>
    </resultMap>

    <sql id="storeMstDtoColumnList">
        sm.store_idx,
        sm.store_cd,
        sm.store_nm,
        sm.owner_nm,
        sm.region_cd,
        COALESCE(reg.code_nm, CAST(sm.region_cd AS VARCHAR)) AS region_nm,
        sm.store_tel,
        sm.address,
        sm.latitude,
        sm.longitude,
        sm.store_status,
        COALESCE(st.code_nm, CAST(sm.store_status AS VARCHAR)) AS store_status_nm,
        (COALESCE(sm.closed_yn, 'N') = 'Y') AS closed_yn,
        sm.cont_end_dt,
        sm.auto_renewal_yn,
        sm.store_type,
        COALESCE(typ.code_nm, CAST(sm.store_type AS VARCHAR)) AS store_type_nm,
        sm.sv_id,
        usv.user_name AS sv_nm,
        CAST(sm.created_at AS TIMESTAMP) AS created_at,
        CAST(sm.updated_at AS TIMESTAMP) AS updated_at,
        sm.adress_detail,
        sm.zip_cd,
        sm.brand_cd,
        COALESCE(br.code_nm, CAST(sm.brand_cd AS VARCHAR)) AS brand_nm,
        sm.cont_start_dt,
        sm.business_number,
        sm.first_cont_dt,
        sm.transfer_date,
        sm.fr_fee,
        sm.edu_fee,
        sm.insu_deposit,
        sm.cont_deposit,
        sm.cont_manager,
        ucs.user_name AS cont_manager_nm,
        sm.edu_manager,
        ues.user_name AS edu_manager_nm,
        sm.cont_area,
        sm.real_area,
        sm.floor,
        sm.parking_count,
        sm.premium_fee,
        sm.monthly_rent,
        sm.rent_deposit,
        sm.notes,
        sm.prop_idx,
        sm.partner_idx
    </sql>

    <sql id="storeMstFromJoins">
        FROM store_mst sm
                 LEFT JOIN code_mst reg ON reg.grp_cd = 20
                     AND CAST(reg.code_cd AS TEXT) = CAST(sm.region_cd AS TEXT)
                 LEFT JOIN code_mst st ON st.grp_cd = 10
                     AND CAST(st.code_cd AS TEXT) = CAST(sm.store_status AS TEXT)
                 LEFT JOIN code_mst typ ON typ.grp_cd = 30
                     AND CAST(typ.code_cd AS TEXT) = CAST(sm.store_type AS TEXT)
                 LEFT JOIN code_mst br ON br.grp_cd = 40
                     AND CAST(br.code_cd AS TEXT) = CAST(sm.brand_cd AS VARCHAR)
                 LEFT JOIN user_mst ucs ON ucs.user_id = sm.cont_manager
                 LEFT JOIN user_mst ues ON ues.user_id = sm.edu_manager
                 <!-- 담당SV 는 이원 상태다 — 화면에서 저장한 행은 sv_id 에 로그인ID(이메일)가,
                      과거 이관 데이터는 사람 이름이 들어 있다. user_id 로만 조인하면 1041건 중
                      1034건이 sv_nm = null 이 되어 SV 이름 검색·필터가 통째로 헛돈다.
                      이름으로도 찾되, 동명이인으로 행이 불어나면 안 되므로 LATERAL + LIMIT 1 로
                      한 명만 고른다(로그인ID 일치를 이름 일치보다 우선). -->
                 LEFT JOIN LATERAL (
                     SELECT u.user_name
                     FROM user_mst u
                     WHERE TRIM(COALESCE(sm.sv_id, '')) &lt;&gt; ''
                       AND (u.user_id = TRIM(sm.sv_id) OR u.user_name = TRIM(sm.sv_id))
                     ORDER BY (u.user_id = TRIM(sm.sv_id)) DESC, u.user_idx
                     LIMIT 1
                 ) usv ON TRUE
    </sql>

    <sql id="storeListWhere">
        <where>
            <if test="q.brandNm != null and q.brandNm != ''">
                AND COALESCE(br.code_nm, CAST(sm.brand_cd AS VARCHAR)) = #{q.brandNm}
            </if>
            <if test="q.regionNms != null and q.regionNms.size() &gt; 0">
                AND COALESCE(reg.code_nm, CAST(sm.region_cd AS VARCHAR)) IN
                <foreach collection="q.regionNms" item="nm" open="(" separator="," close=")">
                    #{nm}
                </foreach>
            </if>
            <if test="q.storeStatusNms != null and q.storeStatusNms.size() &gt; 0">
                AND COALESCE(st.code_nm, CAST(sm.store_status AS VARCHAR)) IN
                <foreach collection="q.storeStatusNms" item="nm" open="(" separator="," close=")">
                    #{nm}
                </foreach>
            </if>
            <if test="q.storeNm != null and q.storeNm != ''">
                AND sm.store_nm ILIKE '%' || #{q.storeNm} || '%'
            </if>
            <if test="q.storeCd != null and q.storeCd != ''">
                AND COALESCE(sm.store_cd, '') ILIKE '%' || #{q.storeCd} || '%'
            </if>
            <if test="q.ownerNm != null and q.ownerNm != ''">
                AND COALESCE(sm.owner_nm, '') ILIKE '%' || #{q.ownerNm} || '%'
            </if>
            <if test="q.storeTel != null and q.storeTel != ''">
                AND COALESCE(sm.store_tel, '') ILIKE '%' || #{q.storeTel} || '%'
            </if>
            <if test="q.address != null and q.address != ''">
                AND (COALESCE(sm.address, '') || ' ' || COALESCE(sm.adress_detail, ''))
                    ILIKE '%' || #{q.address} || '%'
            </if>
            <if test="q.contStartDt != null and q.contStartDt != ''">
                AND CAST(sm.cont_start_dt AS TEXT) ILIKE '%' || #{q.contStartDt} || '%'
            </if>
            <if test="q.contEndDt != null and q.contEndDt != ''">
                AND CAST(sm.cont_end_dt AS TEXT) ILIKE '%' || #{q.contEndDt} || '%'
            </if>
            <if test="q.sv != null and q.sv != ''">
                AND (COALESCE(sm.sv_id, '') ILIKE '%' || #{q.sv} || '%'
                 OR COALESCE(usv.user_name, '') ILIKE '%' || #{q.sv} || '%')
            </if>
            <if test="q.businessNumber != null and q.businessNumber != ''">
                AND COALESCE(sm.business_number, '') ILIKE '%' || #{q.businessNumber} || '%'
            </if>
            <if test="q.notes != null and q.notes != ''">
                AND COALESCE(sm.notes, '') ILIKE '%' || #{q.notes} || '%'
            </if>
        </where>
    </sql>

    <select id="selectStoreListOrdered" resultMap="storeMstDto">
        SELECT
        <include refid="storeMstDtoColumnList"/>
        <include refid="storeMstFromJoins"/>
        ORDER BY sm.store_idx DESC
    </select>

    <select id="selectStoreListPaged" resultMap="storeMstDto">
        SELECT
        <include refid="storeMstDtoColumnList"/>
        <include refid="storeMstFromJoins"/>
        <include refid="storeListWhere"/>
        ORDER BY sm.store_idx DESC
        <if test="q.limit != null">
            LIMIT #{q.limit} OFFSET #{q.offset}
        </if>
    </select>

    <select id="countStoreList" resultType="int">
        SELECT CAST(COUNT(*) AS INTEGER)
        FROM store_mst sm
        <if test="q.brandNm != null and q.brandNm != ''">
            LEFT JOIN code_mst br ON br.grp_cd = 40
                AND CAST(br.code_cd AS TEXT) = CAST(sm.brand_cd AS VARCHAR)
        </if>
        <if test="q.regionNms != null and q.regionNms.size() &gt; 0">
            LEFT JOIN code_mst reg ON reg.grp_cd = 20
                AND CAST(reg.code_cd AS TEXT) = CAST(sm.region_cd AS TEXT)
        </if>
        <if test="q.storeStatusNms != null and q.storeStatusNms.size() &gt; 0">
            LEFT JOIN code_mst st ON st.grp_cd = 10
                AND CAST(st.code_cd AS TEXT) = CAST(sm.store_status AS TEXT)
        </if>
        <if test="q.sv != null and q.sv != ''">
            LEFT JOIN LATERAL (
                SELECT u.user_name
                FROM user_mst u
                WHERE TRIM(COALESCE(sm.sv_id, '')) &lt;&gt; ''
                  AND (u.user_id = TRIM(sm.sv_id) OR u.user_name = TRIM(sm.sv_id))
                ORDER BY (u.user_id = TRIM(sm.sv_id)) DESC, u.user_idx
                LIMIT 1
            ) usv ON TRUE
        </if>
        <include refid="storeListWhere"/>
    </select>

    <select id="selectStoresByStoreNmLike" resultMap="storeMstDto">
        SELECT
        <include refid="storeMstDtoColumnList"/>
        <include refid="storeMstFromJoins"/>
        WHERE sm.store_nm ILIKE #{pattern}
           OR COALESCE(sm.sv_id, '') ILIKE #{pattern}
           OR COALESCE(usv.user_name, '') ILIKE #{pattern}
        ORDER BY sm.store_idx DESC
    </select>

    <select id="countStoreNmDuplicate" resultType="int">
        SELECT CAST(COUNT(*) AS INTEGER)
        FROM store_mst sm
        WHERE LOWER(TRIM(COALESCE(sm.store_nm, ''))) = LOWER(TRIM(#{nm}))
    </select>

    <select id="countStoreNmDuplicateExclude" resultType="int">
        SELECT CAST(COUNT(*) AS INTEGER)
        FROM store_mst sm
        WHERE LOWER(TRIM(COALESCE(sm.store_nm, ''))) = LOWER(TRIM(#{nm}))
          AND sm.store_idx &lt;&gt; #{excludeIdx}
    </select>

    <select id="countAddressDuplicate" resultType="int">
        SELECT CAST(COUNT(*) AS INTEGER)
        FROM store_mst sm
        WHERE LOWER(TRIM(COALESCE(sm.address, ''))) = LOWER(TRIM(#{addr}))
          AND COALESCE(TRIM(sm.zip_cd), '') = COALESCE(TRIM(#{zip}), '')
    </select>

    <select id="countAddressDuplicateExclude" resultType="int">
        SELECT CAST(COUNT(*) AS INTEGER)
        FROM store_mst sm
        WHERE LOWER(TRIM(COALESCE(sm.address, ''))) = LOWER(TRIM(#{addr}))
          AND COALESCE(TRIM(sm.zip_cd), '') = COALESCE(TRIM(#{zip}), '')
          AND sm.store_idx &lt;&gt; #{excludeIdx}
    </select>

    <!-- SELECT 열 순서 = StoreDeleteBlockerRow record 컴포넌트 선언 순서.
         store_mst 를 참조하면서 ON DELETE 절이 없는 FK 들 — 하나라도 걸리면
         DELETE 가 23503 으로 떨어지므로 무엇이 막는지 미리 세어 알려준다. -->
    <select id="countDeleteBlockers" resultType="com.yeokjeon.erp.franchise.dto.StoreDeleteBlockerRow">
        SELECT
            CAST((SELECT COUNT(*) FROM user_mst u
                   WHERE u.store_idx = #{storeIdx}) AS INTEGER) AS owner_user_cnt,
            CAST((SELECT COUNT(*) FROM store_nfc_tag t
                   WHERE t.store_idx = #{storeIdx}) AS INTEGER) AS nfc_tag_cnt,
            CAST((SELECT COUNT(*) FROM bbs_post p
                   WHERE p.store_idx = #{storeIdx}) AS INTEGER) AS bbs_post_cnt,
            CAST((SELECT COUNT(*) FROM activity_plan_store a
                   WHERE a.store_idx = #{storeIdx}) AS INTEGER) AS plan_store_cnt
    </select>
</mapper>
