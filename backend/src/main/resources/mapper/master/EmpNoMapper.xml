<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yeokjeon.erp.master.mapper.EmpNoMapper">

    <select id="selectEmpNo" resultType="java.lang.String">
        SELECT emp_no
        FROM user_mst
        WHERE user_idx = #{userIdx}
    </select>

    <update id="upsertEmpNo">
        UPDATE user_mst
        SET emp_no = #{empNo}
        WHERE user_idx = #{userIdx}
    </update>

</mapper>
