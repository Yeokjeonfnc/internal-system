<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yeokjeon.erp.mail.mapper.MailNotifMapper">

    <!--
        수신 메일 알림 적재 (mal001-N).

        INSERT ... SELECT ... WHERE NOT EXISTS 인 이유가 이 매퍼의 존재 이유다.
        Resend 웹훅은 at-least-once 라 같은 메일이 여러 번 들어오고, mail_webhook_log
        재처리 배치도 같은 메일을 다시 훑는다. 단순 INSERT 면 그때마다 알림이 한 줄씩
        늘어 알림함이 같은 메일로 도배된다.

        중복 판정 키는 (notif_typ, act_idx, user_id) 3개 전부다.
          - notif_typ 을 빼면 같은 번호의 활동 알림(ACTIVITY_APPROVAL)과 충돌해
            메일 알림이 조용히 안 들어간다. act_idx 는 테이블마다 번호 공간이 다르다.
          - user_id 를 빼면 여러 명이 받은 메일에서 첫 사람만 알림을 받는다.

        notif_mst 에는 이 조합의 유니크 제약이 없다. 즉 완전한 동시성 방어는 아니고,
        같은 메일을 정확히 같은 순간에 두 스레드가 처리하면 이론적으로 두 줄이 들어갈 수
        있다. 실제로는 그럴 수 없다 — 알림은 MailReceiveService.ingestReceived 가
        "이번에 새로 만든 메일(created=true)" 일 때만 부르고, 그 판정은
        mail_mst.resend_email_id UNIQUE 가 지키기 때문에 한 메일당 한 번만 도달한다.
        (제약을 걸려면 notif_mst 에 부분 유니크 인덱스가 필요한데, 그 테이블은 active
        모듈 소유라 여기서 손대지 않았다.)

        appr_yn/read_yn 은 NOT NULL 이고 기본값이 있지만 명시적으로 넣는다 — 전자결재의
        ActNotif.prePersist 도 같은 값을 직접 채운다. 메일 알림에 결재 개념은 없으므로
        appr_yn 은 'N' 으로 고정이다.
    -->
    <insert id="insertIfAbsent">
        INSERT INTO notif_mst (user_id, msg_txt, notif_typ, act_idx, appr_yn, read_yn, create_dt)
        SELECT #{userId}, #{msgTxt}, #{notifTyp}, #{actIdx,jdbcType=INTEGER}, 'N', 'N', now()
        WHERE NOT EXISTS (
            SELECT 1
            FROM notif_mst n
            WHERE n.notif_typ = #{notifTyp}
              AND n.act_idx   = #{actIdx,jdbcType=INTEGER}
              AND n.user_id   = #{userId}
        )
    </insert>

    <!--
        알림 대상 관리자(최후 폴백).

        admin_yn='Y' 는 이 ERP 의 슈퍼관리자 판정 기준과 같다(MenuAccessGuard).
        메일 권한(MAL001)으로 고르지 않는 이유: 권한 테이블을 훑으면 대상이 수십 명으로
        늘어 알림함이 남의 메일로 가득 찬다. 폴백은 "아무도 못 받는 상황"만 막으면 되고,
        그건 최소 인원이어야 한다.

        work_yn='Y' 로 퇴사자를 뺀다. user_id NULL 도 뺀다 — 로그인 계정이 없는 사원이
        실제로 있고, 그 행이 섞이면 user_id NOT NULL 인 notif_mst INSERT 가 통째로 터진다.
    -->
    <select id="selectAdminUserIds" resultType="java.lang.String">
        SELECT u.user_id AS user_id
        FROM user_mst u
        WHERE u.user_id IS NOT NULL
          AND u.admin_yn = 'Y'
          AND u.work_yn  = 'Y'
        ORDER BY u.user_id
    </select>
</mapper>
