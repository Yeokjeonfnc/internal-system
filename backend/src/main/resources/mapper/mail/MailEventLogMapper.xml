<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yeokjeon.erp.mail.mapper.MailEventLogMapper">

    <resultMap id="mailEventLogRow" type="com.yeokjeon.erp.mail.dto.MailEventLogJdbcRow">
        <constructor>
            <arg column="event_idx" javaType="java.lang.Long"/>
            <arg column="mail_idx" javaType="java.lang.Long"/>
            <arg column="resend_email_id" javaType="java.lang.String"/>
            <arg column="event_type" javaType="java.lang.String"/>
            <arg column="recipient" javaType="java.lang.String"/>
            <arg column="occurred_at" javaType="java.time.OffsetDateTime"/>
            <arg column="detail" javaType="java.lang.String"/>
            <arg column="svix_id" javaType="java.lang.String"/>
            <arg column="created_at" javaType="java.time.OffsetDateTime"/>
        </constructor>
    </resultMap>

    <!--
        ON CONFLICT (svix_id) DO NOTHING 이므로 반환값 0 = "이미 처리한 중복 웹훅".
        호출부가 이 값으로 신규 여부를 판정하니 절대 무시하지 말 것.

        재동기화 배치가 만든 이벤트는 svix_id 가 NULL 인데, NULL 끼리는 UNIQUE 충돌이
        나지 않아 중복 차단이 걸리지 않는다. 웹훅 경로는 반드시 svixId 를 채워야 한다.

        occurred_at 은 NOT NULL 이라 COALESCE 로 막는다. 웹훅에 created_at 이 빠지는
        경우가 드물게 있는데, 그때 INSERT 가 통째로 죽으면 이벤트를 통째로 잃는다.
    -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="eventIdx" keyColumn="event_idx">
        INSERT INTO mail_event_log (
            mail_idx, resend_email_id, event_type, recipient, occurred_at,
            detail, svix_id, created_at
        ) VALUES (
            #{mailIdx,jdbcType=BIGINT},
            #{resendEmailId,jdbcType=VARCHAR},
            #{eventType},
            #{recipient,jdbcType=VARCHAR},
            COALESCE(#{occurredAt,jdbcType=TIMESTAMP_WITH_TIMEZONE}, now()),
            CAST(#{detailJson,jdbcType=VARCHAR} AS jsonb),
            #{svixId,jdbcType=VARCHAR},
            now()
        )
        ON CONFLICT (svix_id) DO NOTHING
    </insert>

    <!-- 상세 화면의 배달 타임라인. 인덱스 (mail_idx, occurred_at DESC) 를 그대로 탄다 -->
    <select id="selectByMailIdx" resultMap="mailEventLogRow">
        SELECT e.event_idx,
               e.mail_idx,
               e.resend_email_id,
               e.event_type,
               e.recipient,
               e.occurred_at,
               e.detail,
               e.svix_id,
               e.created_at
        FROM mail_event_log e
        WHERE e.mail_idx = #{mailIdx}
        ORDER BY e.occurred_at DESC, e.event_idx DESC
        LIMIT #{limit}
    </select>

    <!--
        메일 행보다 먼저 도착해 mail_idx 가 비어 있는 이벤트를 다시 붙인다.
        이걸 돌리지 않으면 상세 화면의 배달 타임라인이 영영 비어 보인다.

        서브쿼리로 대상을 limit 만큼만 고정하는 이유: 고아가 수만 건 쌓인 상태에서
        한 트랜잭션이 전부 잠그면 그동안 웹훅 수신이 막힌다.

        그 서브쿼리에 EXISTS 를 반드시 붙여야 한다. 없으면 limit 개 슬롯을 '영원히 매칭될 수
        없는 미아'가 차지해 버리고, 매 실행이 같은 행만 다시 골라 UPDATE 0 을 반복한다
        (커서가 전진하지 않는다). 그런 미아는 실제로 생긴다 — 같은 Resend 계정을 쓰는 다른
        시스템이나 수동 테스트 발송, updateSendSent 트랜잭션이 롤백돼 resend_email_id 가
        저장되지 않은 건 등. batch-size 가 20 이라 임계치는 고작 20건이고, 그 뒤로 들어온
        정상 미아는 영영 연결되지 않아 상세 화면 배달 타임라인이 계속 비어 보인다.

        EXISTS 로 '지금 붙일 짝이 있는' 미아만 고르면 선택된 행은 전부 실제로 갱신되므로
        커서가 매 실행 확실히 전진한다. 조건은 mail_mst.resend_email_id UNIQUE 인덱스를 탄다.
    -->
    <update id="relinkOrphans">
        UPDATE mail_event_log e
        SET mail_idx = m.mail_idx
        FROM mail_mst m
        WHERE e.mail_idx IS NULL
          AND e.resend_email_id IS NOT NULL
          AND m.resend_email_id = e.resend_email_id
          AND e.event_idx IN (SELECT o.event_idx
                              FROM mail_event_log o
                              WHERE o.mail_idx IS NULL
                                AND o.resend_email_id IS NOT NULL
                                AND EXISTS (SELECT 1
                                            FROM mail_mst m2
                                            WHERE m2.resend_email_id = o.resend_email_id)
                              ORDER BY o.event_idx
                              LIMIT #{limit})
    </update>
</mapper>
