<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yeokjeon.erp.mail.mapper.MailPrefMapper">

    <resultMap id="mailPrefRow" type="com.yeokjeon.erp.mail.dto.MailPrefJdbcRow">
        <constructor>
            <arg column="pref_key" javaType="java.lang.String"/>
            <arg column="pref_val" javaType="java.lang.String"/>
        </constructor>
    </resultMap>

    <!--
        updated_at 은 읽지 않는다. 개인 설정은 "언제 바꿨는지"가 화면에 필요 없고,
        조회할 때마다 안 쓰는 컬럼을 실어 나를 이유가 없다.

        키 순 정렬은 응답을 안정시키기 위한 것이다. 순서가 매번 달라지면 화면 진단이나
        캐시 비교(응답 해시)가 매번 틀리게 나온다.
    -->
    <select id="selectByUserId" resultMap="mailPrefRow">
        SELECT p.pref_key, p.pref_val
        FROM mail_pref p
        WHERE p.user_id = #{userId}
        ORDER BY p.pref_key
    </select>

    <!--
        다건 upsert.

        PK 가 (user_id, pref_key) 라 ON CONFLICT DO UPDATE 로 삽입·수정이 한 문장에 처리된다.
        먼저 SELECT 해서 INSERT/UPDATE 를 가르면, 같은 사용자가 두 화면에서 동시에 저장할 때
        둘 다 "없음"으로 읽고 둘 다 INSERT 를 시도해 PK 충돌이 난다.

        VALUES 를 foreach 로 펼쳐 한 문장으로 보낸다. 키마다 문장을 나누면 왕복도 늘지만,
        무엇보다 중간에 하나가 실패했을 때 일부만 반영된 채 남는다(설정 화면은 여러 항목을
        한 번에 저장한다).

        빈 Map 은 서비스가 먼저 거른다 — VALUES 가 비면 문법 오류다.
        pref_val 은 NOT NULL DEFAULT '' 라 null 을 넘기면 제약 위반이므로 COALESCE 로 막는다.
        (값을 지우는 것은 "빈 문자열 저장"으로 표현한다. 행을 지우는 개념을 따로 두지 않는 이유는
         키가 없는 것과 값이 빈 것을 화면이 구분하지 않기 때문이다.)
    -->
    <insert id="upsertBatch">
        INSERT INTO mail_pref (user_id, pref_key, pref_val, updated_at)
        VALUES
        <foreach collection="prefs" index="prefKey" item="prefVal" separator=",">
            (#{userId}, #{prefKey}, COALESCE(#{prefVal,jdbcType=VARCHAR}, ''), now())
        </foreach>
        ON CONFLICT (user_id, pref_key) DO UPDATE
        SET pref_val   = EXCLUDED.pref_val,
            updated_at = now()
    </insert>
</mapper>
