# 참고: 현재 현장 서버가 실제로 쓰는 설정은 이 파일이 아니라
# deploy/package/field-server/caddy/Caddyfile.http 다(호스트명 없이 :8080 수신,
# Cloudflare Origin Rule 이 호스트명으로 라우팅). 도메인이 바뀌어도 그쪽은 수정할 게 없다.

# 운영 / 테스트 — 구 test.yeokjeon.com 은 폐기
on.yeokjeon.com, on-test.yeokjeon.com {
	encode gzip zstd

	handle /api/* {
		reverse_proxy 127.0.0.1:3001
	}

	root * "C:\y-on\internal-system\app_flutter\build\web"
	try_files {path} /index.html
	file_server
}

yeokjeon.com {
	encode gzip zstd

	handle /api/* {
		reverse_proxy 127.0.0.1:3011
	}

	root * "C:\y-on\internal-system\app_flutter\build\web"
	try_files {path} /index.html
