JAVA_HOME=C:\Program Files\Eclipse Adoptium\jdk-17.0.19.10-hotspot
JAR_PATH=C:\y-on\internal-system\backend\target\erp-backend-1.0.0.jar
LOG_DIR=C:\y-on\internal-system\deploy\prod\logs
BACKEND_PORT=3011
DB_HOST=localhost
DB_PORT=5432
DB_NAME=yj_db_prod
DB_USER=postgres
DB_PASSWORD=CHANGE_ME

# Resend 메일(mal001). 비워 두면 메일 송수신만 비활성되고 나머지는 정상 동작한다.
RESEND_API_KEY=
# 웹훅 서명 시크릿(Resend 대시보드 > Webhooks). 비워 두면 /api/mail/webhook 이
# 검증할 수 없으므로 모든 요청을 거부한다 = 수신 메일·배달상태가 들어오지 않는다.
# 예전에는 미설정 시 검증을 건너뛰어(fail-open) 아무나 메일 이력을 심을 수 있었다.
RESEND_WEBHOOK_SECRET=
RESEND_FROM_EMAIL=
# 요청 본문의 fromEmail 로 허용할 주소(콤마 구분). 비우면 RESEND_FROM_EMAIL 하나만 허용.
# 목록에 없는 주소로 발송을 요청하면 거부한다(도메인 안 발신자 사칭 차단).
RESEND_ALLOWED_FROM_EMAILS=
# 배치(본문 수집·발송 워커)를 켤 인스턴스에서만 true. 두 인스턴스에서 켜면 rate limit 을 두 배로 먹는다.
RESEND_SYNC_ENABLED=false
