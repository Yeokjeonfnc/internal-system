JAVA_HOME=C:\Program Files\Eclipse Adoptium\jdk-17.0.19.10-hotspot
BACKEND_PORT=3001
DB_HOST=localhost
# Use 5433 here if PostgreSQL 16 was installed on 5433 because another PostgreSQL uses 5432.
DB_PORT=5432
DB_NAME=yj_db_test
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
FILE_STORAGE_ROOT=C:\y-on\yon-field-server\storage
FILE_MAX_SIZE=52428800
# 로그인 토큰 서명 키 — 64자 랜덤 16진수. 이 값이 바뀌면 전원 재로그인이 필요하다.
# 미설정 시 기동할 때마다 임의 키가 생성되어 재시작마다 로그아웃된다.
AUTH_TOKEN_SECRET=CHANGE_ME_64_HEX
# 토큰 유효시간(시간). 기본 12.
AUTH_TOKEN_VALIDITY_HOURS=12
# Kakao REST API 키(주소 검색 등). 저장소에서 제거했으므로 여기서 주입한다.
KAKAO_REST_API_KEY=CHANGE_ME
# 신규 계정 생성·비밀번호 초기화 시 설정되는 초기 비밀번호.
# 미설정 시 application.yml 의 기본값(저장소에 공개된 값)이 쓰이므로 반드시 덮어쓸 것.
# DB_PASSWORD 와 같은 값을 쓰지 말 것 — 하나가 유출되면 둘 다 위험해진다.
DEFAULT_USER_PASSWORD=CHANGE_ME
# Resend 메일(mal001). 비워 두면 메일 송수신만 비활성되고 나머지는 정상 동작한다.
RESEND_API_KEY=
# 웹훅 서명 시크릿(Resend 대시보드 > Webhooks). 비워 두면 /api/mail/webhook 이
# 검증할 수 없으므로 모든 요청을 거부한다 = 수신 메일·배달상태가 들어오지 않는다.
# 예전에는 미설정 시 검증을 건너뛰어(fail-open) 아무나 메일 이력을 심을 수 있었다.
RESEND_WEBHOOK_SECRET=
RESEND_FROM_EMAIL=
# 요청 본문의 fromEmail 로 허용할 주소(콤마 구분). 비우면 RESEND_FROM_EMAIL 하나만 허용.
# 목록에 없는 주소로 발송을 요청하면 거부한다(도메인 안 발신자 사칭 차단).
RESEND_ALLOWED_FROM_EMAILS=
# 배치(본문 수집·발송 워커)를 켤 인스턴스에서만 true. 두 인스턴스에서 켜면 rate limit 을 두 배로 먹는다.
RESEND_SYNC_ENABLED=false
# 주의: SPRING_* 로 시작하는 줄은 start-backend.ps1 이 무시한다.
# (SPRING_PROFILES_ACTIVE=dev 한 줄이면 다음 기동에서 운영 테이블이 drop-create 되기 때문)
