:8080 {
	encode gzip zstd

	# 접근 감사 로그 — 누가 언제 어떤 경로를 호출했는지 JSON 으로 기록(자동 롤링).
	log {
		output file {$YON_APP_HOME}\logs\caddy\access.log {
			roll_size 20MiB
			roll_keep 10
			roll_keep_for 720h
		}
		format json
	}

	# Cloudflare 를 건너뛴 접속 차단.
	# FortiGate VIP 가 공인 203.234.249.145:8080 을 이 서버로 그대로 넘기기 때문에,
	# 호스트명 제한이 없으면 공인 IP 로 직접 때려 Cloudflare 의 WAF·레이트리밋·접근기록을
	# 통째로 우회할 수 있다. Cloudflare 를 거친 요청은 Host 가 서비스 도메인이고,
	# 공인 IP 직접 접속은 Host 가 IP 라 여기서 갈린다.
	# 허용 대상: 서비스 도메인 / 서버 자기 자신(health-check.ps1) / 사내망 IP.
	# respond 는 directive 순서상 handle 보다 뒤라 단독으로 쓰면 아래 catch-all handle 에
	# 먼저 잡혀 동작하지 않는다. 그래서 handle 그룹의 맨 앞에 둔다(handle 은 파일 순서대로 평가).
	@untrusted_host not host on.yeokjeon.com on-test.yeokjeon.com yeokjeon.com localhost 127.0.0.1 192.168.30.30
	handle @untrusted_host {
		respond "Misdirected request" 421 {
			close
		}
	}

	# 공통 보안 헤더 — 클릭재킹·MIME 스니핑·리퍼러 유출 차단.
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		# 서버 종류 노출 최소화
		-Server
	}

	# flutter_service_worker.js 는 목록에 없어서 4시간(max-age=14400) 캐시되고 있었다.
	# 서비스워커가 캐시되면 서버 파일은 새것인데 브라우저만 옛 앱 셸을 계속 실행해,
	# 응답코드·Last-Modified 로는 배포 성공으로 보이는 가장 찾기 어려운 배포 실패가 된다.
	@app_shell {
		path / /landing.html /index.html /main.dart.js /flutter.js /flutter_bootstrap.js /flutter_service_worker.js /version.json /manifest.json
	}
	header @app_shell Cache-Control "no-store, no-cache, must-revalidate"

	handle /api/* {
		reverse_proxy 127.0.0.1:3001
	}

	# 루트(도메인만 접속)는 랜딩 페이지. 앱 내부 새로고침(/#/login 등)은 프래그먼트가
	# 서버로 전달되지 않으므로, landing.html 자체 스크립트가 감지해 index.html로 넘긴다.
	handle / {
		root * "{$YON_APP_HOME}\web"
		rewrite * /landing.html
		file_server
	}

	handle {
		root * "{$YON_APP_HOME}\web"
		try_files {path} /index.html
		file_server
	}
}
